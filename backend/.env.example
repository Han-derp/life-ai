# Life AI environment template. Copy to backend/.env and fill your values.
APP_TIMEZONE=Asia/Shanghai
PERSONA=companion
APP_PASSWORD=

# Default OpenAI-compatible model service (DeepSeek by default).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=1.0
DEEPSEEK_TIMEOUT_SECONDS=60

# Optional task-level provider aliases: deepseek or openai.
LLM_CHAT_PROVIDER=deepseek
LLM_EXTRACT_PROVIDER=deepseek
LLM_IMPRESSION_PROVIDER=deepseek
LLM_REVIEW_PROVIDER=deepseek
LLM_VISION_PROVIDER=deepseek
LLM_DEADLINE_BREAKDOWN_PROVIDER=deepseek

# Optional per-tier overrides. Leave blank to inherit the default model service.
# roleplay: chat / proactive / review / deadline_breakdown
LLM_TIER_ROLEPLAY_PROVIDER=
LLM_TIER_ROLEPLAY_BASE_URL=
LLM_TIER_ROLEPLAY_API_KEY=
LLM_TIER_ROLEPLAY_MODEL=
# analysis: extraction / impression generation
LLM_TIER_ANALYSIS_PROVIDER=
LLM_TIER_ANALYSIS_BASE_URL=
LLM_TIER_ANALYSIS_API_KEY=
LLM_TIER_ANALYSIS_MODEL=
# vision: image understanding and OCR
LLM_TIER_VISION_PROVIDER=
LLM_TIER_VISION_BASE_URL=
LLM_TIER_VISION_API_KEY=
LLM_TIER_VISION_MODEL=

# Context budgets (tokens).
CONTEXT_SYSTEM_BUDGET=3000
CONTEXT_RECENT_CHAT_BUDGET=2000
CONTEXT_TOTAL_BUDGET=4000

# Background proactive / memory workflows.
PROACTIVE_ENABLED=true
PROACTIVE_TICK_SECONDS=300
